[Unit]
Description=Disable PCI runtime power management (autosuspend) for the ES8336 audio controller
After=multi-user.target sound.target

[Service]
Type=oneshot
# 0000:00:0e.0 is the PCI address of the audio controller on the
# UNOWHY Y13G011S4EI. Verify yours with:
#   lspci -nnk | grep -A3 -i audio
# and edit the path below if it differs on your machine.
ExecStart=/bin/sh -c 'echo on > /sys/bus/pci/devices/0000:00:0e.0/power/control'

[Install]
WantedBy=multi-user.target
